{
  "manifest_version": 3,
  "name": "Extrator de Pacientes",
  "version": "1.0",
  "description": "Extrai dados de pacientes e gera planilha Excel.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["xlsx.full.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
